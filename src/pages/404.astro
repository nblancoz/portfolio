---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArrowRight from '@/components/icons/ArrowRight.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translate = useTranslations(lang);
const homePath = getLocalizedPath('/', lang);
---

<BaseLayout
  lang={lang}
  title={translate('notFoundPage.metaTitle')}
  description={translate('notFoundPage.metaDescription')}
>
  <div class="flex min-h-[60vh] flex-col items-center justify-center py-12 text-center">
    <div class="w-full max-w-xl space-y-8 rounded-2xl border border-zinc-800/80 bg-zinc-900/40 p-8 sm:p-12">
      <div class="flex items-center justify-center gap-2 font-mono text-xs text-emerald-400">
        <span>{translate('notFoundPage.terminalTag')}</span>
        <span class="text-zinc-600">·</span>
        <span class="rounded border border-red-500/20 bg-red-500/10 px-2 py-0.5 text-red-400">
          {translate('notFoundPage.statusLabel')}
        </span>
      </div>
      <div class="space-y-3">
        <div class="font-mono text-6xl font-bold tracking-tight text-zinc-100 sm:text-7xl">
          {translate('notFoundPage.statusCode')}
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-100 sm:text-3xl">
          {translate('notFoundPage.title')}
        </h1>
        <p class="mx-auto max-w-md text-sm leading-relaxed text-zinc-400 sm:text-base">
          {translate('notFoundPage.description')}
        </p>
      </div>
      <div class="pt-2">
        <a
          href={homePath}
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 px-6 py-3 font-mono text-xs font-semibold text-zinc-950 transition-colors hover:bg-emerald-400"
        >
          <span>{translate('notFoundPage.backHome')}</span>
          <ArrowRight size={14} />
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
