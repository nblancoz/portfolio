---
import ArrowDown from '@/components/icons/ArrowDown.astro';
import Copyright from '@/components/icons/Copyright.astro';
import Dot from '@/components/icons/Dot.astro';
import { useTranslations, type SupportedLanguage } from '@/i18n/utils';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const translate = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-zinc-800/80 bg-zinc-950/90">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 font-mono text-xs text-zinc-500 sm:flex-row">
    <div class="flex items-center gap-2">
      <span class="flex items-center gap-1.5">
        <Copyright size={11} class="text-zinc-500" />
        <span>
          {currentYear} {translate('footer.rights')}
        </span>
      </span>
      <Dot size={3} class="text-zinc-700" />
      <a
        href="https://github.com/nblancoz/portfolio/blob/main/LICENSE"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-zinc-300"
      >
        {translate('footer.license')}
      </a>
    </div>
    <div class="flex flex-wrap items-center gap-5 text-zinc-400">
      <a
        href="https://github.com/nblancoz"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-emerald-400"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/nblancoz"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-emerald-400"
      >
        LinkedIn
      </a>
      <a href="mailto:nblancozappala@gmail.com" class="transition-colors hover:text-emerald-400">
        Email
      </a>
      <a
        href={translate('site.cvFile')}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-1.5 rounded-md border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-zinc-200 transition-colors hover:border-emerald-500/50 hover:text-emerald-400"
      >
        <ArrowDown size={12} class="transition-transform group-hover:translate-y-0.5" />
        <span>{translate('footer.downloadCv')}</span>
      </a>
    </div>
  </div>
</footer>
