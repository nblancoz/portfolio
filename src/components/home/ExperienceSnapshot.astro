---
import ArrowRight from '@/components/icons/ArrowRight.astro';
import { getLocalizedPath, useTranslations, type SupportedLanguage } from '@/i18n/utils';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const translate = useTranslations(lang);
---

<section class="space-y-6">
  <div class="flex items-center justify-between border-b border-zinc-800/80 pb-3">
    <h2 class="font-mono text-xs uppercase tracking-wider text-zinc-500">
      {translate('home.experience.sectionTag')}
    </h2>
    <a
      href={getLocalizedPath('/experience', lang)}
      class="group flex items-center gap-1 font-mono text-xs text-emerald-400 hover:underline"
    >
      <span>{translate('home.experience.viewAll')}</span>
      <ArrowRight size={12} class="transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
  <div class="relative space-y-6 before:absolute before:inset-0 before:left-2 before:w-px before:bg-zinc-800">
    <div class="group relative pl-8">
      <span class="absolute left-1.25 top-1.5 h-2 w-2 rounded-full bg-emerald-400 ring-4 ring-zinc-950"></span>
      <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
        <h3 class="text-base font-semibold text-zinc-100">
          {translate('home.experience.job1Title')}{' '}
          <span class="font-mono text-sm text-emerald-400">
            {translate('home.experience.job1Company')}
          </span>
        </h3>
        <span class="font-mono text-xs text-zinc-500">
          {translate('home.experience.job1Period')}
        </span>
      </div>
      <p class="mt-1.5 text-sm text-zinc-400">{translate('home.experience.job1Description')}</p>
    </div>
    <div class="group relative pl-8">
      <span class="absolute left-1.25 top-1.5 h-2 w-2 rounded-full bg-zinc-600 ring-4 ring-zinc-950 transition-colors group-hover:bg-zinc-400"></span>
      <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
        <h3 class="text-base font-semibold text-zinc-100">
          {translate('home.experience.job2Title')}{' '}
          <span class="font-mono text-sm text-zinc-400">
            {translate('home.experience.job2Company')}
          </span>
        </h3>
        <span class="font-mono text-xs text-zinc-500">
          {translate('home.experience.job2Period')}
        </span>
      </div>
      <p class="mt-1.5 text-sm text-zinc-400">{translate('home.experience.job2Description')}</p>
    </div>
    <div class="group relative pl-8">
      <span class="absolute left-1.25 top-1.5 h-2 w-2 rounded-full bg-zinc-700 ring-4 ring-zinc-950 transition-colors group-hover:bg-zinc-500"></span>
      <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
        <h3 class="text-base font-semibold text-zinc-100">
          {translate('home.experience.job3Title')}{' '}
          <span class="font-mono text-sm text-zinc-500">
            {translate('home.experience.job3Company')}
          </span>
        </h3>
        <span class="font-mono text-xs text-zinc-500">
          {translate('home.experience.job3Period')}
        </span>
      </div>
      <p class="mt-1.5 text-sm text-zinc-400">{translate('home.experience.job3Description')}</p>
    </div>
  </div>
</section>
