---
import ArrowRight from '@/components/icons/ArrowRight.astro';
import ArrowUpRight from '@/components/icons/ArrowUpRight.astro';
import { getLocalizedPath, useTranslations, type SupportedLanguage } from '@/i18n/utils';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const translate = useTranslations(lang);
---

<section class="flex flex-col items-start justify-between gap-6 rounded-2xl border border-zinc-800/80 bg-zinc-900/40 p-6 sm:p-8 md:flex-row md:items-center">
  <div class="space-y-2">
    <div class="flex items-center gap-2 font-mono text-xs text-emerald-400">
      <span class="size-2 rounded-full bg-emerald-400"></span>
      <span>{translate('home.contactCta.badge')}</span>
    </div>
    <h3 class="text-xl font-bold tracking-tight text-zinc-100 sm:text-2xl">
      {translate('home.contactCta.title')}
    </h3>
    <p class="max-w-xl text-sm leading-relaxed text-zinc-400">
      {translate('home.contactCta.description')}
    </p>
  </div>
  <div class="flex shrink-0 flex-wrap items-center gap-3">
    <a
      href={getLocalizedPath('/contact', lang)}
      class="group flex items-center gap-2 rounded-lg bg-emerald-500 px-5 py-2.5 font-mono text-xs font-semibold text-zinc-950 transition-colors hover:bg-emerald-400"
    >
      <span>{translate('home.contactCta.primaryButton')}</span>
      <ArrowRight size={13} class="transition-transform group-hover:translate-x-0.5" />
    </a>
    <a
      href="https://www.linkedin.com/in/nblancoz"
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center gap-1.5 rounded-lg border border-zinc-800 bg-zinc-900 px-4 py-2.5 font-mono text-xs text-zinc-300 transition-colors hover:border-zinc-700 hover:text-zinc-100"
    >
      <span>{translate('home.contactCta.secondaryButton')}</span>
      <ArrowUpRight size={12} class="text-zinc-500 transition-colors group-hover:text-zinc-300" />
    </a>
  </div>
</section>
