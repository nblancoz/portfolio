---
import '../styles/global.css';
import { useTranslations, type SupportedLanguage } from '../i18n/utils';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const translate = useTranslations(lang);
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{translate('site.title')}</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-slate-950 p-6 text-slate-100">
    <main class="w-full max-w-md space-y-4 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-white">{translate('site.title')}</h1>
      <p class="text-slate-400">{translate('site.description')}</p>
      <div class="flex justify-center gap-4 pt-4 text-sm">
        <a
          href="/"
          class:list={[
            lang === 'es'
              ? 'font-medium text-sky-400 underline'
              : 'text-slate-400 hover:text-sky-400',
          ]}
        >
          ES
        </a>
        <span class="text-slate-600">|</span>
        <a
          href="/en"
          class:list={[
            lang === 'en'
              ? 'font-medium text-sky-400 underline'
              : 'text-slate-400 hover:text-sky-400',
          ]}
        >
          EN
        </a>
      </div>
    </main>
  </body>
</html>
