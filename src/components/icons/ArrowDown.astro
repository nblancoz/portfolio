---
interface Props {
  size?: number;
  class?: string;
}

const { size = 14, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M12 5v14M19 12l-7 7-7-7"></path>
</svg>
