---
import Logo from '@/components/Logo.astro';
import {
  getLocalizedPath,
  getSwitchLocalePath,
  useTranslations,
  type SupportedLanguage,
} from '@/i18n/utils';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const translate = useTranslations(lang);

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/es' || currentPath === '/es/';
const isProjects =
  currentPath === '/projects' ||
  currentPath === '/projects/' ||
  currentPath === '/es/projects' ||
  currentPath === '/es/projects/';
const isExperience =
  currentPath === '/experience' ||
  currentPath === '/experience/' ||
  currentPath === '/es/experience' ||
  currentPath === '/es/experience/';
const isEducation =
  currentPath === '/education' ||
  currentPath === '/education/' ||
  currentPath === '/es/education' ||
  currentPath === '/es/education/';
const isContact =
  currentPath === '/contact' ||
  currentPath === '/contact/' ||
  currentPath === '/es/contact' ||
  currentPath === '/es/contact/';

const navItems = [
  { key: 'nav.home' as const, path: '/', active: isHome },
  { key: 'nav.projects' as const, path: '/projects', active: isProjects },
  { key: 'nav.experience' as const, path: '/experience', active: isExperience },
  { key: 'nav.education' as const, path: '/education', active: isEducation },
  { key: 'nav.contact' as const, path: '/contact', active: isContact },
];

const esPath = getSwitchLocalePath(Astro.url, 'es');
const enPath = getSwitchLocalePath(Astro.url, 'en');
---

<header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a
      href={getLocalizedPath('/', lang)}
      class="group flex items-center gap-2 font-mono text-sm font-medium tracking-tight"
    >
      <Logo size={26} class="shrink-0 transition-transform group-hover:scale-105" />
      <div class="flex items-center gap-1.5">
        <span class="text-emerald-400">~</span>
        <span class="text-zinc-500">/</span>
        <span class="text-zinc-100 transition-colors group-hover:text-emerald-400">
          nicolasblanco.dev
        </span>
        <span class="ml-0.5 inline-block h-4 w-2 origin-center animate-terminal-blink bg-emerald-400"></span>
      </div>
    </a>
    <nav class="hidden items-center gap-7 text-sm font-medium md:flex">
      {navItems.map((item) => (
        <a
          href={item.path === '#' ? '#' : getLocalizedPath(item.path, lang)}
          class:list={[
            'transition-colors',
            item.active
              ? 'relative text-zinc-100 after:absolute after:-bottom-5.25 after:left-0 after:h-0.5 after:w-full after:bg-emerald-400'
              : 'text-zinc-400 hover:text-zinc-200',
          ]}
        >
          {translate(item.key)}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <div class="flex items-center rounded-lg border border-zinc-800 bg-zinc-900 p-1 font-mono text-xs">
        <a
          href={enPath}
          data-lang-switch
          class:list={[
            'rounded-md px-2 py-1 font-medium transition-all',
            lang === 'en' ? 'bg-zinc-800 text-emerald-400' : 'text-zinc-500 hover:text-zinc-300',
          ]}
          aria-label="English"
        >
          EN
        </a>
        <a
          href={esPath}
          data-lang-switch
          class:list={[
            'rounded-md px-2 py-1 font-medium transition-all',
            lang === 'es' ? 'bg-zinc-800 text-emerald-400' : 'text-zinc-500 hover:text-zinc-300',
          ]}
          aria-label="Español"
        >
          ES
        </a>
      </div>
    </div>
  </div>
  <div class="flex overflow-x-auto border-t border-zinc-900 px-6 py-2 md:hidden">
    <nav class="flex gap-4 text-xs font-medium">
      {navItems.map((item) => (
        <a
          href={item.path === '#' ? '#' : getLocalizedPath(item.path, lang)}
          class:list={[
            'whitespace-nowrap py-1 transition-colors',
            item.active ? 'font-semibold text-emerald-400' : 'text-zinc-400 hover:text-zinc-200',
          ]}
        >
          {translate(item.key)}
        </a>
      ))}
    </nav>
  </div>
</header>
